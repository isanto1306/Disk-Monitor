# Copy this file to .env and replace every CHANGE_ME value.
# Never commit your real .env file.

DISK_MONITOR_USERNAME=CHANGE_ME_USERNAME
DISK_MONITOR_PASSWORD=CHANGE_ME_WITH_AT_LEAST_12_CHARACTERS
DISK_MONITOR_SESSION_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Set to true only when Disk Monitor is served exclusively through HTTPS.
DISK_MONITOR_SESSION_HTTPS_ONLY=false
